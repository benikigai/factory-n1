{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:static",
  "outputDirectory": "web/dist",
  "headers": [
    { "source": "/runs/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
